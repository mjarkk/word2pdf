# Test environment. word2pdf's PDFs are compared with those of a regular LibreOffice, so both run
# here with the same fonts and hyphenation dictionaries:
#   test       converting and comparing (scripts/test.sh)
#   reference  adds the official LibreOffice build of the version in LO_VERSION
#              (scripts/make-references.sh)
FROM docker.io/library/debian:trixie-slim AS test
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        fonts-crosextra-caladea fonts-crosextra-carlito fonts-dejavu fonts-liberation \
        fonts-noto-core fonts-noto-cjk \
        hyphen-de hyphen-en-us hyphen-fr hyphen-nl \
        poppler-utils python3 python3-pil time \
    && rm -rf /var/lib/apt/lists/*
ENV LC_ALL=C.UTF-8

FROM test AS reference
ARG LO_VERSION
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates curl libdbus-1-3 libnss3 libx11-xcb1 libxinerama1 libxrandr2 libxrender1 \
        libxext6 libsm6 libice6 libcairo2 libcups2 libglib2.0-0t64 \
    && rm -rf /var/lib/apt/lists/* \
    && case "$(uname -m)" in \
        x86_64) arch=x86-64 dir=x86_64 sum=fd0e8f8f2408dd2e5b90286e60f3f97cf566ba441cd48cfc5bcc68067303e0bc ;; \
        aarch64) arch=aarch64 dir=aarch64 sum=f8e8b1d30abde0d530d727ce1b26909ccbedc3d76bcf75d93b3dd5fcd5b8d278 ;; \
       esac \
    && curl -sSfL -o /tmp/lo.tar.gz \
        "https://downloadarchive.documentfoundation.org/libreoffice/old/$LO_VERSION/deb/$dir/LibreOffice_${LO_VERSION}_Linux_${arch}_deb.tar.gz" \
    && echo "$sum  /tmp/lo.tar.gz" | sha256sum -c - \
    && mkdir /tmp/lo && tar -xzf /tmp/lo.tar.gz -C /tmp/lo --strip-components=1 \
    && dpkg -i /tmp/lo/DEBS/*.deb \
    && rm -rf /tmp/lo /tmp/lo.tar.gz \
    && ln -s /opt/libreoffice*/program/soffice /usr/local/bin/soffice
