<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuration defaults of word2pdf, applied on top of LibreOffice's own. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:name="Setup" oor:package="org.openoffice">
    <node oor:name="L10N">
      <!-- A fixed locale (number formats, default paper size, ...) instead of "the
           system's": conversions do not depend on the environment, and the system paper
           size is not probed by running paperconf. word2pdf - -locale overrides it. -->
      <prop oor:name="ooSetupSystemLocale" oor:op="fuse"><value>en-US</value></prop>
      <prop oor:name="ooLocale" oor:op="fuse"><value>en-US</value></prop>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Misc">
      <!-- nothing else touches the files; no .~lock files next to input or output -->
      <prop oor:name="UseLocking" oor:op="fuse"><value>false</value></prop>
      <prop oor:name="UseDocumentOOoLockFile" oor:op="fuse"><value>false</value></prop>
      <prop oor:name="UseDocumentSystemFileLocking" oor:op="fuse"><value>false</value></prop>
    </node>
    <node oor:name="Filter">
      <node oor:name="PDF">
        <node oor:name="Export">
          <!-- defaults, overridable per call -->
          <prop oor:name="UseTaggedPDF" oor:op="fuse"><value>false</value></prop>
          <prop oor:name="ExportFormFields" oor:op="fuse"><value>false</value></prop>
        </node>
      </node>
    </node>
  </oor:component-data>
</oor:data>
