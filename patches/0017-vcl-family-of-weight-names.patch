+    // A face named like a family ("Calibri Light") that is not installed: its family, or the
+    // metric-compatible replacement of that, in the face's weight. Asked before the prematch
+    // hook, because fontconfig always answers with some font, usually an unrelated fallback.
+    auto FindFamilyOfWeightName = [this, &FindMetricCompatibleFont](
+        FontSelectPattern& rFontSelData, const OUString& rName) -> PhysicalFontFamily*
+    {
+        OUString aName = rName;
+        FontWeight eWeight = rFontSelData.GetWeight();
+        const OUString aSearchName = rFontSelData.maSearchName;
+        while (StripWeightWord(aName, eWeight))
+        {
+            rFontSelData.maSearchName = GetEnglishSearchFontName(aName);
+            PhysicalFontFamily* pFound = ImplFindFontFamilyBySearchName(rFontSelData.maSearchName);
+            if (!pFound)
+                pFound = FindMetricCompatibleFont(rFontSelData);
+            if (pFound)
+            {
+                rFontSelData.SetWeight(eWeight);
+                return pFound;
+            }
+        }
+        rFontSelData.maSearchName = aSearchName;
+        return nullptr;
+    };
