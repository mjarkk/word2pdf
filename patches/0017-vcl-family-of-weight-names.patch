+// Only weights: the width names that fontconfig has aliases for ("Arial Narrow", "Helvetica
+// Narrow") are metric-compatible with other narrow families, not with the plain ones.
+constexpr std::pair<std::u16string_view, FontWeight> aWeightWords[] =
+{
+    { u"Thin",       WEIGHT_THIN },
+    { u"Hairline",   WEIGHT_THIN },
+    { u"ExtraLight", WEIGHT_ULTRALIGHT },
+    { u"UltraLight", WEIGHT_ULTRALIGHT },
+    { u"Light",      WEIGHT_LIGHT },
+    { u"SemiLight",  WEIGHT_SEMILIGHT },
+    { u"DemiLight",  WEIGHT_SEMILIGHT },
+    { u"Book",       WEIGHT_NORMAL },
+    { u"Regular",    WEIGHT_NORMAL },
+    { u"Medium",     WEIGHT_MEDIUM },
+    { u"SemiBold",   WEIGHT_SEMIBOLD },
+    { u"DemiBold",   WEIGHT_SEMIBOLD },
+    { u"Demi",       WEIGHT_SEMIBOLD },
+    { u"Bold",       WEIGHT_BOLD },
+    { u"ExtraBold",  WEIGHT_ULTRABOLD },
+    { u"UltraBold",  WEIGHT_ULTRABOLD },
+    { u"Black",      WEIGHT_BLACK },
+    { u"Heavy",      WEIGHT_BLACK },
+    { u"ExtraBlack", WEIGHT_BLACK },
+    { u"UltraBlack", WEIGHT_BLACK },
+};
+
+// "Calibri Light" -> "Calibri", WEIGHT_LIGHT. A weight that is already set (bold text in
+// Calibri Light) is kept.
+static bool StripWeightWord(OUString& rName, FontWeight& rWeight)
+{
+    for (const auto& [word, weight] : aWeightWords)
+    {
+        OUString aRest;
+        if (!rName.endsWithIgnoreAsciiCase(word, &aRest) || !aRest.endsWith(u" "))
+            continue;
+        rName = aRest.trim();
+        if (rWeight == WEIGHT_DONTKNOW || rWeight == WEIGHT_NORMAL)
+            rWeight = weight;
+        return true;
+    }
+    return false;
+}
