diff --git a/sal/osl/unx/embeddedfs.cxx b/sal/osl/unx/embeddedfs.cxx
new file mode 100644
index 000000000..07b455000
--- /dev/null
+++ b/sal/osl/unx/embeddedfs.cxx
@@ -0,0 +1,209 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#include <sal/config.h>
+
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "embeddedfs.hxx"
+
+namespace
+{
+struct Child
+{
+    std::string name;
+    unsigned char type;
+};
+
+// Written once by lo_embeddedfs_register before any other thread exists, read-only afterwards.
+std::string g_aRoot;
+std::map<std::string, const lo_embedded_file*, std::less<>> g_aFiles;
+std::map<std::string, std::vector<Child>, std::less<>> g_aDirs;
+
+void addChild(const std::string& rDir, const std::string& rName, unsigned char nType)
+{
+    auto& rChildren = g_aDirs[rDir];
+    for (const auto& rChild : rChildren)
+        if (rChild.name == rName)
+            return;
+    rChildren.push_back({ rName, nType });
+}
+
+// Lists which embedded files a run looks for, to maintain the set of embedded files.
+void trace(const char* pWhat, const std::string& rRel)
+{
+    static const char* pTrace = getenv("LO_SLIM_TRACE_FILES");
+    if (!pTrace)
+        return;
+    if (FILE* f = fopen(pTrace, "a"))
+    {
+        fprintf(f, "%s\t%s\n", pWhat, rRel.c_str());
+        fclose(f);
+    }
+}
+
+// Maps an absolute system path to a normalized path relative to the root ("" is the root).
+bool relativePath(const char* pPath, std::string& rRel)
+{
+    if (g_aRoot.empty() || !pPath)
+        return false;
+    std::string_view aPath(pPath);
+    if (!aPath.starts_with(g_aRoot))
+        return false;
+    aPath.remove_prefix(g_aRoot.size());
+    if (!aPath.empty() && aPath.front() != '/')
+        return false;
+
+    rRel.clear();
+    size_t i = 0;
+    while (i < aPath.size())
+    {
+        while (i < aPath.size() && aPath[i] == '/')
+            ++i;
+        size_t nEnd = aPath.find('/', i);
+        if (nEnd == std::string_view::npos)
+            nEnd = aPath.size();
+        std::string_view aSegment = aPath.substr(i, nEnd - i);
+        i = nEnd;
+        if (aSegment.empty() || aSegment == ".")
+            continue;
+        if (aSegment == "..")
+        {
+            size_t nSlash = rRel.rfind('/');
+            rRel.erase(nSlash == std::string::npos ? 0 : nSlash);
+            continue;
+        }
+        if (!rRel.empty())
+            rRel += '/';
+        rRel += aSegment;
+    }
+    return true;
+}
+}
+
+namespace osl::embeddedfs
+{
+struct Dir
+{
+    const std::vector<Child>* pChildren;
+    size_t nNext;
+    struct dirent aEntry;
+};
+
+const char* root() { return g_aRoot.c_str(); }
+
+bool contains(const char* pPath)
+{
+    std::string aRel;
+    return relativePath(pPath, aRel);
+}
+
+const lo_embedded_file* findFile(const char* pPath)
+{
+    std::string aRel;
+    if (!relativePath(pPath, aRel))
+        return nullptr;
+    auto it = g_aFiles.find(aRel);
+    trace(it == g_aFiles.end() ? "miss" : "open", aRel);
+    return it == g_aFiles.end() ? nullptr : it->second;
+}
+
+int stat(const char* pPath, struct stat* pBuf)
+{
+    std::string aRel;
+    if (!relativePath(pPath, aRel))
+    {
+        errno = ENOENT;
+        return -1;
+    }
+    std::memset(pBuf, 0, sizeof(*pBuf));
+    pBuf->st_nlink = 1;
+    if (auto it = g_aFiles.find(aRel); it != g_aFiles.end())
+    {
+        pBuf->st_mode = S_IFREG | 0444;
+        pBuf->st_size = it->second->size;
+        pBuf->st_ino = std::distance(g_aFiles.begin(), it) + 1;
+        return 0;
+    }
+    if (g_aDirs.find(aRel) != g_aDirs.end())
+    {
+        pBuf->st_mode = S_IFDIR | 0555;
+        return 0;
+    }
+    trace("stat-miss", aRel);
+    errno = ENOENT;
+    return -1;
+}
+
+Dir* openDir(const char* pPath)
+{
+    std::string aRel;
+    if (!relativePath(pPath, aRel))
+    {
+        errno = ENOENT;
+        return nullptr;
+    }
+    auto it = g_aDirs.find(aRel);
+    trace(it == g_aDirs.end() ? "dir-miss" : "dir", aRel);
+    if (it == g_aDirs.end())
+    {
+        errno = g_aFiles.contains(aRel) ? ENOTDIR : ENOENT;
+        return nullptr;
+    }
+    return new Dir{ &it->second, 0, {} };
+}
+
+struct dirent* readDir(Dir* pDir)
+{
+    if (pDir->nNext >= pDir->pChildren->size())
+        return nullptr;
+    const Child& rChild = (*pDir->pChildren)[pDir->nNext++];
+    std::memset(&pDir->aEntry, 0, sizeof(pDir->aEntry));
+    std::strncpy(pDir->aEntry.d_name, rChild.name.c_str(), sizeof(pDir->aEntry.d_name) - 1);
+#ifdef _DIRENT_HAVE_D_TYPE
+    pDir->aEntry.d_type = rChild.type;
+#endif
+    return &pDir->aEntry;
+}
+
+void closeDir(Dir* pDir) { delete pDir; }
+}
+
+void lo_embeddedfs_register(const char* pRoot, const lo_embedded_file* aFiles, size_t nCount)
+{
+    g_aRoot = pRoot;
+    while (g_aRoot.size() > 1 && g_aRoot.back() == '/')
+        g_aRoot.pop_back();
+    g_aDirs[std::string()];
+    for (size_t i = 0; i < nCount; ++i)
+    {
+        std::string aPath(aFiles[i].path);
+        g_aFiles[aPath] = &aFiles[i];
+        unsigned char nType = DT_REG;
+        for (;;)
+        {
+            size_t nSlash = aPath.rfind('/');
+            std::string aDir = nSlash == std::string::npos ? std::string() : aPath.substr(0, nSlash);
+            addChild(aDir, aPath.substr(nSlash == std::string::npos ? 0 : nSlash + 1), nType);
+            if (aDir.empty())
+                break;
+            aPath = aDir;
+            nType = DT_DIR;
+        }
+    }
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
