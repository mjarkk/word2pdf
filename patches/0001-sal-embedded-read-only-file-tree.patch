+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#pragma once
+
+#include <sal/config.h>
+
+#include <dirent.h>
+#include <sys/stat.h>
+
+#include <osl/detail/embeddedfs.h>
+
+namespace osl::embeddedfs
+{
+struct Dir;
+
+/// The registered root ("/lo") or an empty string when no tree is registered.
+const char* root();
+
+/// Whether the absolute system path lies inside the registered embedded tree.
+bool contains(const char* pPath);
+
+/// The embedded regular file at pPath, or nullptr.
+const lo_embedded_file* findFile(const char* pPath);
+
+/// stat(2) replacement for paths inside the tree; sets errno on failure.
+int stat(const char* pPath, struct stat* pBuf);
+
+/// opendir/readdir/closedir replacements; readdir never returns "." or "..".
+Dir* openDir(const char* pPath);
+struct dirent* readDir(Dir* pDir);
+void closeDir(Dir* pDir);
+}
+
