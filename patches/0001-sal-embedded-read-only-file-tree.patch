+
+/** A file of a read-only file tree that is compiled into the executable. */
+typedef struct
+{
+    /** Path relative to the tree root, '/' separated, without a leading '/'. */
+    const char* path;
+    const unsigned char* data;
+    size_t size;
+} lo_embedded_file;
+
+/** Serve a read-only file tree from memory.
+
+    After this call, the osl file functions resolve every system path below
+    pRoot (an absolute system path like "/lo") from aFiles instead of the real
+    file system.  The table and its data must stay valid for the lifetime of
+    the process.  Must be called once, before any other osl file function and
+    before any other thread is started.
+*/
+SAL_DLLPUBLIC void lo_embeddedfs_register(const char* pRoot, const lo_embedded_file* aFiles,
+                                          size_t nCount);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
