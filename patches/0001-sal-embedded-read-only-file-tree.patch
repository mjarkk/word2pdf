+#include <osl/detail/embeddedfs.h>
+
+/* Paths are system paths (backslash or slash separated, optionally with the \\?\ prefix) and
+   compare case-insensitively, as the file system's would. */
+namespace osl::embeddedfs
+{
+struct Dir;
+
+/// The registered root (like "C:\lo-embedded"), UTF-8, or an empty string when no tree is
+/// registered.
+const char* root();
+
+/// Whether the path lies inside the registered embedded tree.
+bool contains(std::u16string_view aPath);
+
+/// The embedded regular file at the path, or nullptr.
+const lo_embedded_file* findFile(std::u16string_view aPath);
+
+/// FindFirstFileW replacement: describes the file or directory at the path, or sets the last
+/// error and returns false.
+bool find(std::u16string_view aPath, WIN32_FIND_DATAW& rData);
+
+/// Directory listing; readDir returns false with ERROR_NO_MORE_FILES at the end.
+Dir* openDir(std::u16string_view aPath);
+bool readDir(Dir* pDir, WIN32_FIND_DATAW& rData);
+void closeDir(Dir* pDir);
+}
