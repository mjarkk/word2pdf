new file mode 100644
index 000000000..0049cdc87
--- /dev/null
+++ b/sal/osl/w32/embeddedfs.cxx
@@ -0,0 +1,252 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#include <sal/config.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <string>
+#include <vector>
+
+#include <rtl/character.hxx>
+#include <rtl/ustring.hxx>
+
+#include "embeddedfs.hxx"
+
+namespace
+{
+struct Child
+{
+    std::u16string name;
+    const lo_embedded_file* file; // nullptr for a directory
+};
+
+// Written once by lo_embeddedfs_register before any other thread exists, read-only afterwards.
+// The maps are keyed by lower-case paths relative to the root, '/' separated.
+std::string g_aRootUtf8;
+std::u16string g_aRoot;
+std::map<std::u16string, const lo_embedded_file*, std::less<>> g_aFiles;
+std::map<std::u16string, std::vector<Child>, std::less<>> g_aDirs;
+
+bool isSeparator(sal_Unicode c) { return c == '\\' || c == '/'; }
+
+std::u16string lower(std::u16string_view s)
+{
+    std::u16string aLower(s);
+    for (auto& c : aLower)
+        c = static_cast<sal_Unicode>(rtl::toAsciiLowerCase(c));
+    return aLower;
+}
+
+void addChild(std::u16string_view aDir, std::u16string_view aName, const lo_embedded_file* pFile)
+{
+    auto& rChildren = g_aDirs[lower(aDir)];
+    for (const auto& rChild : rChildren)
+        if (rChild.name == aName)
+            return;
+    rChildren.push_back({ std::u16string(aName), pFile });
+}
+
+// Lists which embedded files a run looks for, to maintain the set of embedded files.
+void trace(const char* pWhat, std::u16string_view aRel)
+{
+    static const char* pTrace = getenv("LO_SLIM_TRACE_FILES");
+    if (!pTrace)
+        return;
+    if (FILE* f = fopen(pTrace, "a"))
+    {
+        fprintf(f, "%s\t%s\n", pWhat,
+                OUString(aRel.data(), aRel.size()).toUtf8().getStr());
+        fclose(f);
+    }
+}
+
+bool relativePath(std::u16string_view aPath, std::u16string& rRel)
+{
+    if (g_aRoot.empty())
+        return false;
+    if (aPath.starts_with(u"\\\\?\\"))
+        aPath.remove_prefix(4);
+    if (aPath.size() < g_aRoot.size())
+        return false;
+    for (size_t i = 0; i < g_aRoot.size(); ++i)
+    {
+        if (isSeparator(aPath[i]) ? !isSeparator(g_aRoot[i])
+                                  : rtl::toAsciiLowerCase(aPath[i]) != rtl::toAsciiLowerCase(g_aRoot[i]))
+            return false;
+    }
+    aPath.remove_prefix(g_aRoot.size());
+    if (!aPath.empty() && !isSeparator(aPath.front()))
+        return false;
+
+    rRel.clear();
+    size_t i = 0;
+    while (i < aPath.size())
+    {
+        while (i < aPath.size() && isSeparator(aPath[i]))
+            ++i;
+        size_t nEnd = i;
+        while (nEnd < aPath.size() && !isSeparator(aPath[nEnd]))
+            ++nEnd;
+        std::u16string_view aSegment = aPath.substr(i, nEnd - i);
+        i = nEnd;
+        if (aSegment.empty() || aSegment == u".")
+            continue;
+        if (aSegment == u"..")
+        {
+            size_t nSlash = rRel.rfind('/');
+            rRel.erase(nSlash == std::u16string::npos ? 0 : nSlash);
+            continue;
+        }
+        if (!rRel.empty())
+            rRel += '/';
+        rRel += lower(aSegment);
+    }
+    return true;
+}
+
+void describe(WIN32_FIND_DATAW& rData, std::u16string_view aName, const lo_embedded_file* pFile)
+{
+    rData = {};
+    if (pFile)
+    {
+        rData.dwFileAttributes = FILE_ATTRIBUTE_READONLY;
+        rData.nFileSizeLow = static_cast<DWORD>(pFile->size & 0xFFFFFFFF);
+        rData.nFileSizeHigh = static_cast<DWORD>(static_cast<sal_uInt64>(pFile->size) >> 32);
+    }
+    else
+        rData.dwFileAttributes = FILE_ATTRIBUTE_DIRECTORY;
+    size_t n = std::min(aName.size(), std::size(rData.cFileName) - 1);
+    std::copy_n(aName.data(), n, rData.cFileName);
+}
+}
+
+namespace osl::embeddedfs
+{
+struct Dir
+{
+    const std::vector<Child>* pChildren;
+    size_t nNext;
+};
+
+const char* root() { return g_aRootUtf8.c_str(); }
+
+bool contains(std::u16string_view aPath)
+{
+    std::u16string aRel;
+    return relativePath(aPath, aRel);
+}
+
+const lo_embedded_file* findFile(std::u16string_view aPath)
+{
+    std::u16string aRel;
+    if (!relativePath(aPath, aRel))
+        return nullptr;
+    auto it = g_aFiles.find(aRel);
+    trace(it == g_aFiles.end() ? "miss" : "open", aRel);
+    return it == g_aFiles.end() ? nullptr : it->second;
+}
+
+bool find(std::u16string_view aPath, WIN32_FIND_DATAW& rData)
+{
+    std::u16string aRel;
+    if (!relativePath(aPath, aRel))
+    {
+        SetLastError(ERROR_PATH_NOT_FOUND);
+        return false;
+    }
+    if (aRel.empty())
+    {
+        describe(rData, std::u16string_view(g_aRoot).substr(g_aRoot.find_last_of(u"\\") + 1),
+                 nullptr);
+        return true;
+    }
+    size_t nSlash = aRel.rfind('/');
+    std::u16string_view aParent
+        = nSlash == std::u16string::npos ? std::u16string_view() : std::u16string_view(aRel).substr(0, nSlash);
+    std::u16string_view aName = std::u16string_view(aRel).substr(nSlash + 1);
+    if (auto it = g_aDirs.find(aParent); it != g_aDirs.end())
+    {
+        for (const auto& rChild : it->second)
+        {
+            if (lower(rChild.name) == aName)
+            {
+                describe(rData, rChild.name, rChild.file);
+                return true;
+            }
+        }
+    }
+    trace("stat-miss", aRel);
+    SetLastError(ERROR_FILE_NOT_FOUND);
+    return false;
+}
+
+Dir* openDir(std::u16string_view aPath)
+{
+    std::u16string aRel;
+    if (!relativePath(aPath, aRel))
+    {
+        SetLastError(ERROR_PATH_NOT_FOUND);
+        return nullptr;
+    }
+    auto it = g_aDirs.find(aRel);
+    trace(it == g_aDirs.end() ? "dir-miss" : "dir", aRel);
+    if (it == g_aDirs.end())
+    {
+        SetLastError(g_aFiles.contains(aRel) ? ERROR_DIRECTORY : ERROR_PATH_NOT_FOUND);
+        return nullptr;
+    }
+    return new Dir{ &it->second, 0 };
+}
+
+bool readDir(Dir* pDir, WIN32_FIND_DATAW& rData)
+{
+    if (pDir->nNext >= pDir->pChildren->size())
+    {
+        SetLastError(ERROR_NO_MORE_FILES);
+        return false;
+    }
+    const Child& rChild = (*pDir->pChildren)[pDir->nNext++];
+    describe(rData, rChild.name, rChild.file);
+    return true;
+}
+
+void closeDir(Dir* pDir) { delete pDir; }
+}
+
+void lo_embeddedfs_register(const char* pRoot, const lo_embedded_file* aFiles, size_t nCount)
+{
+    g_aRootUtf8 = pRoot;
+    OUString aRoot = OUString::fromUtf8(pRoot).replace('/', '\\');
+    while (aRoot.getLength() > 1 && aRoot.endsWith("\\"))
+        aRoot = aRoot.copy(0, aRoot.getLength() - 1);
+    g_aRoot = std::u16string(aRoot.getStr(), aRoot.getLength());
+    g_aDirs[std::u16string()];
+    for (size_t i = 0; i < nCount; ++i)
+    {
+        OUString aPathString = OUString::fromUtf8(aFiles[i].path);
+        std::u16string aPath(aPathString.getStr(), aPathString.getLength());
+        g_aFiles[lower(aPath)] = &aFiles[i];
+        const lo_embedded_file* pFile = &aFiles[i];
+        for (;;)
+        {
+            size_t nSlash = aPath.rfind('/');
+            std::u16string aDir = nSlash == std::u16string::npos ? std::u16string() : aPath.substr(0, nSlash);
+            addChild(aDir, std::u16string_view(aPath).substr(nSlash == std::u16string::npos ? 0 : nSlash + 1), pFile);
+            if (aDir.empty())
+                break;
+            aPath = aDir;
+            pFile = nullptr;
+        }
+    }
+}
+
