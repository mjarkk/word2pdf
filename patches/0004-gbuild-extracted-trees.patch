diff --git a/solenv/gbuild/Module.mk b/solenv/gbuild/Module.mk
index 01aed156c..a1986cd46 100644
--- a/solenv/gbuild/Module.mk
+++ b/solenv/gbuild/Module.mk
@@ -404,8 +404,16 @@ define gb_Module__modulefile
 $(patsubst $(1):%,%,$(filter $(1):%,$(gb_Module_MODULELOCATIONS)))/$(2)/Module_$(2).mk
 endef
 
+# A tree extracted by libreoffice-slim (marked by .slim-origin) only contains the modules
+# it needs; the others are skipped instead of being an error.
+gb_Module_EXTRACTED := $(wildcard $(SRCDIR)/.slim-origin)
+
 define gb_Module_add_moduledir
-$(if $(wildcard $(call gb_Module__modulefile,$(1),$(2))),,$(call gb_Output_error,Module does not exist: $(call gb_Module__modulefile,$(1),$(2))))
+$(if $(wildcard $(call gb_Module__modulefile,$(1),$(2))),$(call gb_Module__add_moduledir,$(1),$(2)),$(if $(gb_Module_EXTRACTED),,$(call gb_Output_error,Module does not exist: $(call gb_Module__modulefile,$(1),$(2)))))
+
+endef
+
+define gb_Module__add_moduledir
 include $(call gb_Module__modulefile,$(1),$(2))
 $(call gb_Module_get_target,$(1)) : $$(firstword $$(gb_Module_TARGETSTACK))
 $(call gb_Module_get_l10n_target,$(1)) : $$(firstword $$(gb_Module_L10NTARGETSTACK))
diff --git a/solenv/gbuild/Rdb.mk b/solenv/gbuild/Rdb.mk
index fff774dcb..f845d3782 100644
--- a/solenv/gbuild/Rdb.mk
+++ b/solenv/gbuild/Rdb.mk
@@ -62,14 +62,22 @@ $(call gb_Helper_install_final, \
 
 endef
 
+# A build restricted to some UNO components (see static.mk) only puts those into the services
+# rdb, so the libraries of the other components are not built either.
+gb_Rdb_COMPONENTFILES := $(if $(wildcard $(SRCDIR)/slim/component-files.list),$(file <$(SRCDIR)/slim/component-files.list))
+
 define gb_Rdb_add_component
+$(if $(and $(gb_Rdb_COMPONENTFILES),$(filter services,$(1)),$(filter-out $(gb_Rdb_COMPONENTFILES),$(2))),,\
 $(call gb_Rdb_get_target,$(1)) : $(call gb_ComponentTarget_get_target,$(2))
 $(call gb_Rdb_get_target,$(1)) : COMPONENTS += $(2)
-
+)
 endef
 
+gb_Rdb__module_exists = $(wildcard $(SRCDIR)/$(1)/Module_$(1).mk)
+
+# components of modules missing from an extracted tree are left out (see Module.mk)
 define gb_Rdb_add_components
-$(foreach component,$(2),$(call gb_Rdb_add_component,$(1),$(component)))
+$(foreach component,$(2),$(if $(or $(if $(gb_Module_EXTRACTED),,TRUE),$(call gb_Rdb__module_exists,$(firstword $(subst /, ,$(component))))),$(call gb_Rdb_add_component,$(1),$(component))))
 
 endef
 
